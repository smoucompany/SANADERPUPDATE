# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# App Configuration
VITE_APP_NAME=نظام الإدارة المتكامل
VITE_APP_VERSION=1.0.0
VITE_UPDATE_MANIFEST_URL=https://your-update-server.com/latest.json

# WhatsApp Cloud API (Optional)
VITE_WHATSAPP_TOKEN=your-whatsapp-token
VITE_WHATSAPP_PHONE_ID=your-phone-number-id

# SMTP Email (Optional - configure in Supabase Edge Functions)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-smtp-user@example.com
SMTP_PASS=your-smtp-password-here
